{
  "name": "reputation-widget",
  "version": "0.1.0",
  "description": "White-label Google review & reputation widget for niche agencies",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "create-agency": "node --env-file-if-exists=.env scripts/create-agency.js",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=85 'test/**/*.test.js'",
    "commit-stage": "npm run lint && npm test",
    "test:acceptance": "node --test --test-concurrency=4 'acceptance/specs/**/*.spec.js'",
    "test:smoke": "node --test 'acceptance/smoke/**/*.spec.js'",
    "acceptance-stage": "node scripts/run-acceptance-stage.js",
    "google-stub": "node acceptance/stubs/google-places-stub.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0"
  }
}
